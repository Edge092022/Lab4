# Copy file này thành .env (ở root repo) rồi chỉnh nếu cần. KHÔNG commit .env.

# --- server ---
# Cổng Express. Thiếu → mặc định 3001.
PORT=3001
# Origin duy nhất được CORS cho phép. Thiếu → mặc định http://localhost:5173 (KHÔNG mở cho mọi origin).
CLIENT_ORIGIN=http://localhost:5173

# --- client (Vite chỉ đọc biến có tiền tố VITE_) ---
# Đích của Vite proxy /api. Phải khớp PORT ở trên. Thiếu → mặc định http://localhost:3001.
VITE_API_TARGET=http://localhost:3001
